# Copy to .env and replace the empty password values before starting services.
# Load from the repository root: set -a; source .env; set +a
MYSQL_ROOT_PASSWORD=''
MYSQL_DATABASE=webox
MYSQL_USER=webox
MYSQL_PASSWORD=''
MYSQL_PORT=3306
# Official MySQL 8.4.11 multi-platform manifest, verified during setup.
MYSQL_IMAGE=mysql:8.4.11@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70
DB_URL='jdbc:mysql://127.0.0.1:3306/webox?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=webox
DB_PASSWORD=''
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=''
MEDIA_ROOT="${PWD}/.local/media"

PORT=8080
SESSION_TIMEOUT=8h
SESSION_COOKIE_SECURE=false
AI_TOTAL_TIMEOUT_MS=20000
AI_MAX_RECOMMENDATIONS=3
AI_MAX_CONCURRENT=1
AI_QUEUE_CAPACITY=8
INVENTORY_POLL_INTERVAL_MS=250
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_MAX_DURATION_MS=1800000
SSE_MAX_PER_SESSION=3
SSE_MAX_CONNECTIONS=600
SSE_QUEUE_CAPACITY=256
SSE_WRITE_TIMEOUT_MS=5000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=''
AI_MAX_OUTPUT_TOKENS=512

# Single-instance request limits; increase auth capacity/rate for many employees sharing one NAT.
WEBOX_RATE_LIMIT_AUTH_CAPACITY=60
WEBOX_RATE_LIMIT_AUTH_PER_MINUTE=120
WEBOX_RATE_LIMIT_GLOBAL_AUTH_CAPACITY=600
WEBOX_RATE_LIMIT_GLOBAL_AUTH_PER_MINUTE=1200
WEBOX_RATE_LIMIT_WRITE_CAPACITY=120
WEBOX_RATE_LIMIT_WRITE_PER_MINUTE=300
WEBOX_RATE_LIMIT_AI_CAPACITY=10
WEBOX_RATE_LIMIT_AI_PER_MINUTE=30
WEBOX_MAINTENANCE_ENABLED=true
WEBOX_MAINTENANCE_INITIAL_DELAY_MS=60000
WEBOX_MAINTENANCE_INTERVAL_MS=3600000
WEBOX_MAINTENANCE_BATCH_SIZE=100
WEBOX_MAINTENANCE_QUOTE_RETENTION_HOURS=24
WEBOX_MAINTENANCE_OUTBOX_RETENTION_DAYS=7
WEBOX_MAINTENANCE_MEDIA_RETENTION_HOURS=24
