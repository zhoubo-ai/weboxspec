[Unit]
Description=WeBox meal ordering API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webox
Group=webox
WorkingDirectory=/srv/webox
EnvironmentFile=/etc/webox/application.env
ExecStart=/usr/bin/java -Duser.timezone=UTC -jar /srv/webox/webox-api.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/webox/media /srv/webox/runtime
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
